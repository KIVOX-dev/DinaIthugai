{
  "name": "dinaidhigai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dina Idhigai API: Express + MongoDB + Backblaze B2",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "build:appsail": "node scripts/build-appsail.mjs",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.11.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.7",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
